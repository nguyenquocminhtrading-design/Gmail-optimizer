# Gmail Intelligence Configuration

# Server Settings
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
BASE_URL=http://localhost:8000

# Gmail OAuth Credentials (obtained from Google Cloud Console)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/oauth2callback

# Safety Toggles
DRY_RUN=True
AUTO_LABEL=True
AUTO_ARCHIVE=False

# Classification Thresholds
CONFIDENCE_AUTO_CLASSIFY=0.90
CONFIDENCE_FLAG_REVIEW=0.70

# Optional Google Gemini AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud (OpenAI-compatible fallback tier: Gemini -> Groq -> Ollama -> heuristic)
# Get a free API key at https://console.groq.com — all models share base URL https://api.groq.com/openai/v1
GROQ_API_KEY=
# Text models tried in order when Gemini fails / rate-limits
GROQ_TEXT_MODELS=compound-beta,compound-beta-mini,qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Speech-to-Text via Groq Whisper (enables POST /api/transcribe). Default disabled.
GROQ_STT_ENABLED=False
GROQ_STT_MODEL=whisper-large-v3-turbo
# Text-to-Speech via Groq Orpheus (enables POST /api/speak). Default disabled.
GROQ_TTS_ENABLED=False
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Local fallback (Ollama)
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b

# Database
DATABASE_URL=sqlite:///./gmail_intelligence.db
