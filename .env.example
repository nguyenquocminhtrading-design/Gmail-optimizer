# Gmail Intelligence Configuration

# Server Settings
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
BASE_URL=http://localhost:8000

# Gmail OAuth Credentials (obtained from Google Cloud Console)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/oauth2callback

# Safety Toggles
DRY_RUN=True
AUTO_LABEL=True
AUTO_ARCHIVE=False

# Classification Thresholds
CONFIDENCE_AUTO_CLASSIFY=0.90
CONFIDENCE_FLAG_REVIEW=0.70

# Optional Google Gemini AI API Key
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./gmail_intelligence.db
